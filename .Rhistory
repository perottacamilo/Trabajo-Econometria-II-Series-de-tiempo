#Modelo Lin-Lin
ejercicio1 <- lm(ingresos ~ jtpa_training, data = jtpa_tp)
summary(ejercicio1)
ejercicio1_m <- lm(ingresos ~ jtpa_training, data = subset(jtpa_tp, sex == 0))
ejercicio1_h <- lm(ingresos ~ jtpa_training, data = subset(jtpa_tp, sex == 1))
#Tabla para el ejercicio 1
modelsummary(
list("Coef" = ejercicio1),
title = "Tabla 1.1: Regresión del ingreso sobre capacitación",
stars     = TRUE,
statistic = "std.error",
fmt       = 3,
coef_rename = c(
"jtpa_training" = "Recibio entrenamiento"),
gof_map = c("nobs", "adj.r.squared"))
