#Tabla para el ejercicio 2
modelsummary(
list("Coef" = ejercicio2),
title = "Tabla 7: regresión incluyendo variables de control",
stars     = TRUE,
statistic = "std.error",
fmt       = 3,
coef_rename = c(
"jtpa_training" = "Retorno a la capacitación",
"sex" = "Sexo",
"jtpa_training:sex" = "Diferencia entre el retorno a la capacitación por sexo",
"secund_compl" = "Secundario completo",
"black" = "Afroamericano",
"hispanic" = "Hispano",
"married" = "Casado",
"wkless13" = "Trabajó menos de 13 semanas el último año",
"age2225" = "Entre 22 y 25 años",
"age2629" = "Entre 26 y 29 años",
"age3035" = "Enter 30 y 35 años",
"age3644" = "Entre 35 y 44 años",
"age4554" = "Entre 45 y 54 años"),
gof_map = c("nobs", "adj.r.squared"))
#Prueba Exogeneidad (Ignorabiilida)
variables_balance_1 <- c("secund_compl", "black", "hispanic",
"married", "wkless13", "age2225", "age2629", "age3035", "age3644", "age4554")
resultados_ttest <- data.frame(
Variable = character(),
Media_Control = numeric(),
Media_Tratado = numeric(),
Diferencia = numeric(),
p_valor = numeric(),
stringsAsFactors = FALSE
)
for (var in variables_balance_1) {
x_control <- jtpa_tp[[var]][jtpa_tp$jtpa_offer == 0]
x_tratado <- jtpa_tp[[var]][jtpa_tp$jtpa_offer == 1]
x_control <- x_control[!is.na(x_control)]
x_tratado <- x_tratado[!is.na(x_tratado)]
test <- t.test(x_control, x_tratado)
resultados_ttest <- rbind(resultados_ttest, data.frame(
Variable = var,
Media_Control = round(mean(x_control), 3),
Media_Tratado = round(mean(x_tratado), 3),
Diferencia = round(mean(x_tratado) - mean(x_control), 3),
p_valor = round(test$p.value, 3)
))
}
cat("\n")
print(resultados_ttest)
#Cuadro exportable de exogeneidad
datos_balance <- jtpa_tp[, c(variables_balance_1, "jtpa_offer")]
datasummary_balance(
~ jtpa_offer,
data = datos_balance,
dinm_statistic = "p.value",
title = "Test de Balance de la Muestra",
fmt = 3,
output = "balance_exportado.docx"
)
