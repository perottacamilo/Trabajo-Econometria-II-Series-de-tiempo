#Endogeneidad de jtpa_training
#Es endogena si Cov(jtpa_training;error)≠0
#Hay una variable que no aparece en el modelo y que esta relacionada con jtpa_training

#Prueba de Endogeneidad. Auto selección: Si bien la oferta al curso fue aleatoria
#Cada persona elegía si asistir o no
#Por lo que podría ocurrir que asistan aquellas más motivadas o con más capacidades o caract. no obs.
#Utilizar MCO implica comparar aquellos que se capacitaron contra los que no, algunos eliminados por azar y otros auto-elimnados
#Pero están incluidos tantos los que no recibieron la oferta (Z=0), como los que si (Z=1) y la rechazaron (D=0)
#Como rechazar la oferta no está relacionado con el azar, probablemente rechazaron los menos motivados (no observable)
#Como rechazar o no está relacionado con variables no observables se genera la endogeneidad
#Al utilizar la oferta como Variable Instrumental de la participación real, que se muestra que fue aleatoria
#Se elimina cualquier relacion (Cov) con variables no observables, mostrando exogeneidad



#Exogeneidad
#Ver que la variable instrumental jtpa_offer no esta relacionada con los errores
#Una manera de mostrarlo es ver que la oferta al programa fue de manera aleatoria


#Prueba Exogeneidad (Ignorabiilida)
variables_balance_1 <- c("secund_compl", "black", "hispanic",
                         "married", "wkless13", "age2225", "age2629", "age3035", "age3644", "age4554")


resultados_ttest <- data.frame(
  Variable = character(), 
  Media_Control = numeric(), 
  Media_Tratado = numeric(), 
  Diferencia = numeric(), 
  p_valor = numeric(), 
  stringsAsFactors = FALSE 
)

for (var in variables_balance_1) {
  x_control <- jtpa_tp[[var]][jtpa_tp$jtpa_offer == 0] 
  x_tratado <- jtpa_tp[[var]][jtpa_tp$jtpa_offer == 1] 
  
  
  x_control <- x_control[!is.na(x_control)] 
  x_tratado <- x_tratado[!is.na(x_tratado)] 
  
  test <- t.test(x_control, x_tratado)
  
  resultados_ttest <- rbind(resultados_ttest, data.frame( 
    Variable = var, 
    Media_Control = round(mean(x_control), 3), 
    Media_Tratado = round(mean(x_tratado), 3), 
    Diferencia = round(mean(x_tratado) - mean(x_control), 3),  
    p_valor = round(test$p.value, 3) 
  ))
  
}

cat("\n") 
print(resultados_ttest) 

#Cuadro exportable de exogeneidad
datos_balance <- jtpa_tp[, c(variables_balance_1, "jtpa_offer")]

datasummary_balance(
  ~ jtpa_offer,                  
  data = datos_balance,          
  dinm_statistic = "p.value",    
  title = "Test de Balance de la Muestra",
  fmt = 3,
  output = "balance_exportado.docx" 
)

